#!/bin/sh
# Hotel Pro (owner, 17/11/2026: "mỗi khi cập nhật sửa chữa gì đó cũng phải tự động sao lưu, đồng bộ theo luôn").
# After EVERY commit on this computer (enabled per clone by: git config core.hooksPath .githooks) start
# tools/sau-commit.ps1 as a separate hidden Windows process: code backup to OneDrive + (on main) git push 20 s later.
# Detached with Start-Process: a plain "cmd &" background job is killed when git exits. Never fails the commit.
root=$(git rev-parse --show-toplevel)
branch=$(git rev-parse --abbrev-ref HEAD)
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \
  "Start-Process -WindowStyle Hidden -FilePath powershell.exe -ArgumentList '-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"$root/tools/sau-commit.ps1\" -Root \"$root\" -Branch $branch'" \
  >/dev/null 2>&1
exit 0
