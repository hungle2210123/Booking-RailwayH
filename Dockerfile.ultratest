# ABSOLUTE MINIMAL TEST - Just print and start a basic HTTP server
FROM python:3.11-slim

WORKDIR /app

# Install only Flask
RUN pip install flask gunicorn

# Create inline Python server
RUN echo 'from flask import Flask; app = Flask(__name__); @app.route("/") \n\
def health(): return {"status": "ok"}, 200; \n\
if __name__ == "__main__": \n\
    import os; \n\
    port = int(os.environ.get("PORT", 5000)); \n\
    print(f"STARTING ON PORT {port}", flush=True); \n\
    app.run(host="0.0.0.0", port=port)' > server.py

# Show what we created
RUN cat server.py

ENV PORT=5000

# Run it
CMD ["python3", "-u", "server.py"]
