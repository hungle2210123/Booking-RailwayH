{
  "manifest_version": 3,
  "name": "Gửi về Hotel Pro",
  "version": "1.54.0",
  "description": "Gửi đặt phòng đang xem trên extranet Booking.com (kèm số điện thoại) về web Hotel Pro bằng 1 cú bấm.",
  "permissions": [
    "storage",
    "debugger",
    "alarms",
    "power",
    "browsingData",
    "background",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://admin.booking.com/*",
    "https://*.up.railway.app/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.booking.com/*"
      ],
      "js": [
        "domshot.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.booking.com/*"
      ],
      "js": [
        "verify.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web-production-8f671.up.railway.app/chay-ngay*",
        "http://127.0.0.1:5000/chay-ngay*",
        "http://localhost:5000/chay-ngay*"
      ],
      "js": [
        "chay-ngay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Hotel Pro — cài đặt",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "commands": {
    "capture-booking": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Chụp ảnh đặt phòng đang mở (gửi khách)"
    }
  }
}
