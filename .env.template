# ========================================
# HOTEL BOOKING SYSTEM - ENVIRONMENT CONFIGURATION
# ========================================

# SMART DATABASE CONFIGURATION
# Supports automatic detection: local for development, Railway for production
DATABASE_SOURCE=auto
# Options: 'local', 'railway', 'auto' (recommended)

# LOCAL DEVELOPMENT DATABASE
LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/hotel_booking

# RAILWAY PRODUCTION DATABASE (set automatically by Railway)
# RAILWAY_DATABASE_URL=postgresql://user:pass@host:port/dbname
# POSTGRES_URL=postgresql://user:pass@host:port/dbname (Railway native)

# AI INTEGRATION
GOOGLE_API_KEY=your_gemini_api_key_here

# SECURITY
SECRET_KEY=your-secret-key-here-change-in-production

# DEVELOPMENT SETTINGS
FLASK_ENV=development
FLASK_DEBUG=true

# PRODUCTION SETTINGS (for Railway)
# FLASK_ENV=production
# FLASK_DEBUG=false
