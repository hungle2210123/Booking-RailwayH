# ==========================================
# HOTEL BOOKING SYSTEM - COMPLETE ENVIRONMENT CONFIGURATION
# Pure PostgreSQL + Optimized Railway Crawling System
# ==========================================
# Copy this file to .env and fill in your actual values

# === CORE FLASK CONFIGURATION ===
FLASK_SECRET_KEY=your_secure_random_secret_key_here_change_this

# === SMART DATABASE CONFIGURATION ===
# Choose your database source: 'local', 'railway', or 'auto'
DATABASE_SOURCE=auto

# Local PostgreSQL (for development)
LOCAL_DATABASE_URL=postgresql://username:password@localhost:5432/hotel_booking

# Railway PostgreSQL (for production)
RAILWAY_DATABASE_URL=postgresql://postgres:password@host:port/railway

# Explicit database URL (highest priority if set)
DATABASE_URL=postgresql://username:password@host:port/database

# === AI INTEGRATION ===
# Google Gemini AI for booking screenshot processing
GOOGLE_API_KEY=your_gemini_api_key_here

# === RAILWAY CRAWLING OPTIMIZATION SYSTEM ===
# 🚂 Multiple API-based crawling services for cloud deployment

# Firecrawl API (RECOMMENDED - Best performance, premium features)
# Cost: ~$0.003/request | Features: JavaScript, Screenshots, LLM extraction
# Sign up: https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# ScrapFly API (Good alternative with anti-bot protection)
# Cost: ~$0.001/request | Features: JavaScript, Screenshots, ASP
# Sign up: https://scrapfly.io
SCRAPFLY_API_KEY=sfly_your_scrapfly_api_key_here

# ScraperAPI (Budget option with proxy rotation)
# Cost: ~$0.0001/request | Features: Proxies, Headers rotation
# Sign up: https://scraperapi.com
SCRAPERAPI_KEY=your_scraperapi_key_here

# === PERFORMANCE OPTIMIZATION ===
# Budget management (USD per day)
CRAWL_BUDGET_USD=50.00

# Caching configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Performance monitoring
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_METRICS_COLLECTION=true

# === RAILWAY DEPLOYMENT CONFIGURATION ===
# Railway-specific settings (automatically detected)
RAILWAY_PROJECT_ID=auto_detected_by_railway

# === PRODUCTION SETTINGS ===
ENV=production
DEBUG=false

# === CRAWLING COST COMPARISON ===
# Service          | Cost/Request | Features                    | Recommended Use
# ---------------- | ------------ | --------------------------- | ---------------
# Firecrawl        | $0.003       | JS, Screenshots, LLM        | Production (best quality)
# ScrapFly         | $0.001       | JS, Screenshots, ASP        | Balanced option
# ScraperAPI       | $0.0001      | Proxies, Headers            | Budget/bulk scraping
# Direct HTTP      | $0.000       | Basic HTTP only             | Fallback only
#
# RECOMMENDATION: Start with FIRECRAWL_API_KEY for best results
# Budget example: $50/day = ~16,667 Firecrawl requests or ~50,000 ScrapFly requests

# === QUICK SETUP GUIDE ===
# 1. Copy this file to .env
# 2. Set DATABASE_URL to your PostgreSQL connection string
# 3. Add GOOGLE_API_KEY for AI processing
# 4. Add at least one crawling API key (FIRECRAWL_API_KEY recommended)
# 5. Adjust CRAWL_BUDGET_USD as needed
# 6. Deploy to Railway or run locally

# === TROUBLESHOOTING ===
# - If crawling fails: Check /api/crawl_capabilities for service status
# - If budget exceeded: Increase CRAWL_BUDGET_USD or use lower-cost services
# - If performance issues: Check /performance_dashboard for metrics
# - For Railway: Ensure environment variables are set in Railway dashboard